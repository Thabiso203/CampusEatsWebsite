# Copy this to .env and fill in real values. Never commit .env to git.

PORT=4000

# PostgreSQL connection
DATABASE_URL=postgres://user:password@localhost:5432/campuseats

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Business rules
SERVICE_FEE_PERCENT=10
ORDER_TIMEOUT_MINUTES=5

# SMS (mock provider config — swap for Twilio/Clickatell/etc later)
STAFF_PHONE_NUMBERS=+27821234567,+27837654321
SMS_PROVIDER_API_KEY=changeme
